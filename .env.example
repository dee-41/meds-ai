# Copy this file to ".env" and change values if needed. Never commit ".env".

# Frontend: where the React app finds the backend
VITE_API_URL=http://localhost:5000

# Backend: port to listen on, and the frontend address allowed by CORS
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL (backend only). Replace the placeholders with your own values.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password

# Login sessions. SESSION_SECRET must be a long random string (at least 32 characters).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change_me
# Optional. In production set NODE_ENV=production (cookies then require https).
# If frontend and backend are on different sites, also set SESSION_SAMESITE=none.
# NODE_ENV=development
# SESSION_SAMESITE=lax

# AI provider (Anthropic Claude API). Get a key at https://console.anthropic.com (API access is billed separately from Claude.ai plans).
# Backend only: this key must NEVER be put in a VITE_ variable or in frontend code.
ANTHROPIC_API_KEY=your_api_key_here
# Optional overrides:
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_TIMEOUT_MS=60000